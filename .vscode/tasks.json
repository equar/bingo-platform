{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "run bingo app (Windows)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Run-BingoLocal.ps1",
				"-App",
				"player",
				"-Platform",
				"windows"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Start Bingo website",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Bingo admin",
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev", "--", "--host", "127.0.0.1"],
			"options": { "cwd": "${workspaceFolder}\\bingo-admin" },
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Bingo backend",
			"type": "shell",
			"command": "mvn",
			"args": [
				"spring-boot:run",
				"--define=spring-boot.run.profiles=dev"
			],
			"options": {
				"cwd": "${workspaceFolder}\\bingo-backend",
				"env": {
					"JAVA_TOOL_OPTIONS": "-Djava.io.tmpdir=${env:LOCALAPPDATA}\\BingoPlatform\\tmp"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
