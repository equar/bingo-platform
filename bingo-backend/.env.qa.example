# Copy to .env.qa, fill with unique local-only values, and keep it out of Git.
BINGO_QA_MYSQL_HOST=127.0.0.1
BINGO_QA_MYSQL_PORT=3306
BINGO_QA_MYSQL_DATABASE=bingo_qa
BINGO_QA_MYSQL_USERNAME=bingo_qa_app
BINGO_QA_MYSQL_PASSWORD=replace-with-a-private-random-password
BINGO_QA_FLYWAY_USERNAME=bingo_qa_migrator
BINGO_QA_FLYWAY_PASSWORD=replace-with-a-separate-private-random-password
BINGO_QA_JWT_SECRET=replace-with-a-private-random-secret-at-least-32-bytes
BINGO_QA_SERVER_PORT=8081
BINGO_QA_SMTP_HOST=127.0.0.1
BINGO_QA_SMTP_PORT=1025
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
