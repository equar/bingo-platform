# Copy to .env.test, set a private local password, and keep it out of Git.
# This account must have privileges only on bingo_qa_test.*.
BINGO_TEST_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/bingo_qa_test?createDatabaseIfNotExist=false&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
BINGO_TEST_MYSQL_USERNAME=bingo_qa_test_runner
BINGO_TEST_MYSQL_PASSWORD=replace-with-a-private-random-password
