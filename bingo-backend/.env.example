JWT_SECRET=replace-with-a-private-random-value-at-least-32-utf8-bytes
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bingo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=replace-with-local-mysql-user
SPRING_DATASOURCE_PASSWORD=replace-with-local-mysql-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
APP_DEV_SEED_ENABLED=false
DEV_ADMIN_EMAIL=replace-with-disposable-admin-email
DEV_ADMIN_PASSWORD=replace-with-disposable-admin-password
DEV_ADMIN_PHONE=replace-with-normalized-admin-phone
DEV_ADMIN_NAME=replace-with-admin-display-name
DEV_AGENT_PHONE=replace-with-normalized-agent-phone
DEV_AGENT_PASSWORD=replace-with-disposable-agent-password
DEV_AGENT_PIN=replace-with-disposable-agent-pin
DEV_PLAYER_PHONE=replace-with-normalized-player-phone
DEV_PLAYER_PIN=replace-with-six-digit-player-pin
