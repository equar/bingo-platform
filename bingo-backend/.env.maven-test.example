# Copy to .env.maven-test after the DBA creates bingo_qa_maven_test and its local runner.
# Load these values only in the Maven test process. Never use this account for Android/Admin QA.
BINGO_MAVEN_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/bingo_qa_maven_test?createDatabaseIfNotExist=false&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
BINGO_MAVEN_MYSQL_USERNAME=bingo_qa_maven_runner
BINGO_MAVEN_MYSQL_PASSWORD=<new-random-local-secret>
# Defaults to disabled. Set true only for approved synthetic financial integration tests on this disposable schema.
BINGO_MAVEN_SYNTHETIC_FINANCIAL_TESTS_ENABLED=false
