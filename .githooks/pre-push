#!/bin/sh
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for original in "$hook_dir"/pre-push.bingo-platform-original*; do
  [ -f "$original" ] || continue
  "$original" "$@" || exit $?
done
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(git rev-parse --show-toplevel)/scripts/hooks/Invoke-BingoGitChecks.ps1" -Mode PrePush
