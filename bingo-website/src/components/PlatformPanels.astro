---
import { siteConfig } from "../config/site";

interface PlatformPanel {
  title: string;
  label: string;
  icon: "android" | "iphone";
  availability: "comingSoon" | "released";
  url: string | null;
}

const platformPanels: PlatformPanel[] = [
  {
    title: "Android",
    label: "Google Play",
    icon: "android",
    availability: siteConfig.platforms.android.availability,
    url: siteConfig.platforms.android.url,
  },
  {
    title: "iPhone / iOS",
    label: "App Store",
    icon: "iphone",
    availability: siteConfig.platforms.ios.availability,
    url: siteConfig.platforms.ios.url,
  },
];
---

<section class="platform-grid" aria-label="Platforms coming soon">
  {platformPanels.map((platform) => (
    <article class="platform-card surface-soft">
      <div class="platform-card__icon" aria-hidden="true">
        <span>{platform.icon === "android" ? "A" : "i"}</span>
      </div>
      <div class="platform-card__body">
        <p class="platform-card__label">{platform.label}</p>
        <h3>{platform.title}</h3>
        {platform.availability === "released" && platform.url ? (
          <a class="platform-link" href={platform.url}>Download now</a>
        ) : (
          <div class="state-chip">Coming soon</div>
        )}
      </div>
    </article>
  ))}
</section>
