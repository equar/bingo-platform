---
interface Props {
  variant?: "hero" | "compact" | "download";
}

const { variant = "hero" } = Astro.props;
const compact = variant !== "hero";

const calledNumbers = [1, 14, 17, 22, 28, 33, 42, 45];

const bingoBoard = [
  [1, 14, 22, 33, 45],
  [5, 17, 0, 28, 42],
  [9, 19, 31, 37, 49],
  [4, 12, 25, 36, 50],
  [7, 15, 27, 40, 52],
] as const;

const isCalled = (value: number) => calledNumbers.includes(value);
---

<figure class:list={['phone-preview', compact && 'phone-preview--compact', `phone-preview--${variant}`]}>
  <div class="phone-preview__intro">
    <h3 class="phone-preview__title">A look inside Sunset Bingo</h3>
    <p class="phone-preview__caption">Design preview · Final appearance may vary.</p>
  </div>

  <div class="phone-chassis">
    <div class="phone-notch" aria-hidden="true"></div>
    <div class="phone-screen">
      <div class="phone-topline">
        <span class="phone-brand">Sunset Bingo</span>
        <span class="phone-badge">Coming soon</span>
      </div>

      <div class="phone-hero-card phone-hero-card--brand">
        <p class="phone-eyebrow">Live room preview</p>
        <strong>Sunset Bingo play card</strong>
        <span>Android and iPhone are both coming soon.</span>
      </div>

      <div class="phone-stack">
        <article>
          <p class="phone-label">Called numbers</p>
          <div class="called-number-row" aria-label="Sample called numbers">
            {calledNumbers.map((number) => <span class:list={[isCalled(number) && 'is-active']}>{number}</span>)}
          </div>
        </article>
        <article>
          <p class="phone-label">Current ticket</p>
          <ul class="phone-summary-list">
            <li><span>Card status</span><strong>Ready</strong></li>
            <li><span>Match set</span><strong>Highlighted</strong></li>
            <li><span>Preview mode</span><strong>Static</strong></li>
          </ul>
        </article>
      </div>

      <div class="bingo-board" aria-label="Sample bingo ticket grid">
        <div class="bingo-board__row bingo-board__row--header" aria-hidden="true">
          <span>B</span><span>I</span><span>N</span><span>G</span><span>O</span>
        </div>
        {bingoBoard.map((row, rowIndex) => (
          <div class="bingo-board__row" aria-label={`Bingo row ${rowIndex + 1}`}>
            {row.map((cell: number) => (
              cell === 0 ? (
                <span class="bingo-cell bingo-cell--free" aria-label="Free center">FREE</span>
              ) : (
                <span
                  class:list={['bingo-cell', isCalled(cell) && 'bingo-cell--hit']}
                  aria-label={`${cell}${isCalled(cell) ? ', called' : ''}`}
                >
                  {cell}
                </span>
              )
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
  <figcaption class="phone-preview__footnote">Design preview · Final appearance may vary.</figcaption>
</figure>
