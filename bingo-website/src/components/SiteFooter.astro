---
import { siteConfig } from "../config/site";

interface Props {
  draft?: boolean;
}

const { draft = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-brand">
    <p class="footer-wordmark">Sunset Bingo</p>
    <p>A mobile bingo experience designed for players in Ethiopia.</p>
  </div>

  <div class="footer-columns">
    <section>
      <h2>Support</h2>
      {siteConfig.support.email ? (
        <a href={`mailto:${siteConfig.support.email}`}>{siteConfig.support.email}</a>
      ) : null}
      <a href="/help/">Help / contact</a>
    </section>

    <section>
      <h2>Policies</h2>
      <a href="/privacy/">Privacy{draft ? " (draft)" : ""}</a>
      <a href="/terms/">Terms &amp; game rules{draft ? " (draft)" : ""}</a>
      <a href="/responsible-play/">Responsible play</a>
    </section>

    <section>
      <h2>Explore</h2>
      <a href="/#overview">Overview</a>
      <a href="/download/">Apps</a>
      <a href="/#faq">FAQ</a>
    </section>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} Sunset Bingo</p>
    <p><span class="age-mark" aria-hidden="true">Adults</span> Play responsibly.</p>
  </div>
</footer>
