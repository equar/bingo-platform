---
import { siteConfig } from "../config/site";

interface Props {
  draft?: boolean;
}

const { draft = false } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-brand">
    <p class="footer-wordmark">Sunset Bingo</p>
    <p>Sunset Bingo is a coming-soon mobile bingo experience for Android and iPhone.</p>
  </div>

  <div class="footer-columns">
    <section>
      <h2>Support</h2>
      {siteConfig.support.email ? (
        <a href={`mailto:${siteConfig.support.email}`}>{siteConfig.support.email}</a>
      ) : (
        <p>Support details coming soon.</p>
      )}
      <a href="/help/">Help / contact</a>
    </section>

    <section>
      <h2>Policies</h2>
      <a href="/privacy/">Privacy{draft ? " (draft)" : ""}</a>
      <a href="/terms/">Terms &amp; game rules{draft ? " (draft)" : ""}</a>
    </section>

    <section>
      <h2>Links</h2>
      <a href="/#overview">Overview</a>
      <a href="/download/">Apps</a>
      <a href="/#faq">FAQ</a>
      <a href={siteConfig.siteUrl}>Canonical site</a>
    </section>
  </div>

  <p class="footer-note">
    Public site URL: <a href={siteConfig.siteUrl}>{siteConfig.siteUrl}</a>
  </p>
</footer>
