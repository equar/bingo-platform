---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhonePreview from "../components/PhonePreview.astro";
import PlatformPanels from "../components/PlatformPanels.astro";

const path = "/download/";
---

<BaseLayout
  title="Get Sunset Bingo | Android and iPhone"
  description="Check the official availability of Sunset Bingo for Android and iPhone. Both mobile apps are coming soon for players in Ethiopia."
  path={path}
>
  <section class="page-intro-shell">
    <p class="release-label">Official app links</p>
    <h1 class="page-title">Sunset Bingo is coming to your phone.</h1>
    <p class="page-intro">The Android and iPhone apps are being prepared. When a release is ready, its official download link will appear on this page.</p>
  </section>

  <section class="download-grid">
    <article class="download-panel surface">
      <div class="download-state surface-inset">
        <strong>Coming soon in Ethiopia</strong>
        <p>Choose your platform below to see its current availability.</p>
      </div>
      <PlatformPanels />
      <div class="note-bar">
        <strong>Protect your account and device</strong>
        <p>Only download Sunset Bingo through a link published here. Avoid installation files shared through unverified messages, groups, or websites.</p>
      </div>
    </article>
    <PhonePreview variant="download" />
  </section>

  <section class="two-column">
    <article class="panel"><h2>What to expect</h2><ul><li>Live 75-ball bingo sessions.</li><li>English and Amharic language support.</li><li>Tickets, called numbers, and claims together in the app.</li></ul></article>
    <article class="panel"><h2>Need help?</h2><p>Having trouble with an official release or unsure whether a link is genuine?</p><a class="text-button" href="/help/">Visit help and support</a></article>
  </section>
</BaseLayout>
