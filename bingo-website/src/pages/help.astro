---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const path = "/help/";
const contactsAvailable = Boolean(siteConfig.support.email || siteConfig.support.telegramUrl || siteConfig.support.whatsappUrl);
---

<BaseLayout
  title="Sunset Bingo help and support"
  description="Find official support channels and practical help for the Sunset Bingo mobile app in Ethiopia."
  path={path}
>
  <section class="page-intro-shell">
    <p class="release-label">Help and contact</p>
    <h1 class="page-title">Need support?</h1>
    <p class="page-intro">
      Find official ways to contact Sunset Bingo and the information that can help us understand your issue quickly.
    </p>
  </section>

  <section class="support-grid">
    <article class="support-panel surface" id="support-title">
      <h2>Support details</h2>
      {contactsAvailable ? (
        <div class="support-links">
          {siteConfig.support.email ? <a href={`mailto:${siteConfig.support.email}`}>{siteConfig.support.email}</a> : null}
          {siteConfig.support.telegramUrl ? <a href={siteConfig.support.telegramUrl}>Telegram support</a> : null}
          {siteConfig.support.whatsappUrl ? <a href={siteConfig.support.whatsappUrl}>WhatsApp support</a> : null}
        </div>
      ) : (
        <div class="download-state surface-inset">
          <strong>Support details coming soon.</strong>
          <p>Verified contact channels will be published here before the app launches.</p>
        </div>
      )}
    </article>

    <article class="copy-panel surface">
      <h2>What to include when you ask for help</h2>
      <ul>
        <li>The app version, if you can see it in the app or app settings.</li>
        <li>Your device model and Android or iOS version.</li>
        <li>A short description of the step that failed.</li>
        <li>Any on-screen message you saw.</li>
      </ul>
      <p class="muted">Never share your password, verification code, or mobile-money PIN with anyone claiming to provide support.</p>
    </article>
  </section>

  <section class="two-column">
    <article class="panel"><h2>Account safety</h2><p>Use only the support contacts shown on this page. Sunset Bingo support should never ask for your password or PIN.</p></article>
    <article class="panel"><h2>Responsible play</h2><p>If gaming no longer feels enjoyable or you are spending more than planned, stop and seek support.</p><a class="text-button" href="/responsible-play/">Read responsible-play guidance</a></article>
  </section>
</BaseLayout>
