# Copy this file outside source control and fill in the real values.
# The deployment scripts can upload it to /opt/bingo/backend/.env.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

MYSQL_HOST=YOUR_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=bingo
MYSQL_USER=bingo_app
MYSQL_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_JWT_SECRET
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
BINGO_FLOAT_BANK_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
SPRING_MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
ADMIN_ACCOUNT_ACTIVATION_URL=https://admin.example.com/activate-account

CORS_ALLOWED_ORIGINS=https://bingo.example.com
WEBSOCKET_ALLOWED_ORIGINS=https://bingo.example.com

APP_BUSINESS_TIMEZONE=Africa/Addis_Ababa
APP_WALLET_CURRENCY=ETB
APP_WALLET_DEPOSIT_CONVERSION_RATE=1.000000
APP_PAYMENT_PROVIDER_NAME=Telebirr
APP_PAYMENT_BUSINESS_ACCOUNT=
APP_PAYMENT_INSTRUCTIONS='Submit the payment reference after payment for manual verification.'
APP_GAME_MAX_TICKETS_PER_PLAYER=10
APP_GAME_SESSION_CAPACITY=1000
APP_GAME_TICKET_SALES_CLOSE_ON_SESSION_START=true
APP_GAME_DRAW_INTERVAL=PT10S
APP_AGENT_PIN_RECONFIRM_THRESHOLD=1000.00
APP_AGENT_LOGIN_ATTEMPT_LIMIT=5
APP_AGENT_PIN_ATTEMPT_LIMIT=5
APP_AGENT_PAYOUT_CODE_ATTEMPT_LIMIT=5
APP_AGENT_ATTEMPT_WINDOW=PT15M
APP_DEV_SEED_ENABLED=false
