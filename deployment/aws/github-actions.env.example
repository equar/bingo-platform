# Copy to an ignored, environment-specific file. The deploy workflow chooses
# test or production from the branch; database name and backend port are fixed.
DEPLOY_HOST=REPLACE_WITH_ENVIRONMENT_HOST
DEPLOY_USER=REPLACE_WITH_ENVIRONMENT_USER
DEPLOY_SSH_HOST_KEY=REPLACE_WITH_INDEPENDENTLY_VERIFIED_OPENSSH_HOST_KEY
DEPLOY_SSH_KEY_B64=REPLACE_WITH_BASE64_DEPLOYMENT_PRIVATE_KEY
MYSQL_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
JWT_SECRET=REPLACE_WITH_JWT_SECRET
BINGO_FLOAT_BANK_ENCRYPTION_KEY=REPLACE_WITH_BINGO_FLOAT_BANK_ENCRYPTION_KEY
# Set the provider explicitly. Graph requires all MICROSOFT_GRAPH_* secrets;
# SMTP requires SPRING_MAIL_USERNAME and SPRING_MAIL_PASSWORD.
APP_EMAIL_PROVIDER=graph
APP_EMAIL_FROM=REPLACE_WITH_AUTHORIZED_SENDER_MAILBOX
MICROSOFT_GRAPH_TENANT_ID=REPLACE_WITH_TENANT_ID
MICROSOFT_GRAPH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
MICROSOFT_GRAPH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# SMTP-only credentials; leave blank in Graph mode.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Bootstrap modes remain disabled by default. Workflow-run approval, an expiry,
# and protected GitHub Environment reviewer approval are also required.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_EMAIL_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAILS=
MYSQL_HOST=REPLACE_WITH_DATABASE_HOST
MYSQL_USER=REPLACE_WITH_DATABASE_USER
CORS_ALLOWED_ORIGINS=REPLACE_WITH_COMMA_SEPARATED_ORIGINS
WEBSOCKET_ALLOWED_ORIGINS=REPLACE_WITH_COMMA_SEPARATED_ORIGINS
ADMIN_ACCOUNT_ACTIVATION_URL=REPLACE_WITH_ADMIN_ACTIVATION_URL
SPRING_MAIL_HOST=smtp.office365.com
SPRING_MAIL_PORT=587
VITE_API_BASE_URL=REPLACE_WITH_API_ORIGIN
ADMIN_PUBLIC_URL=REPLACE_WITH_ADMIN_ORIGIN
PUBLIC_SITE_URL=REPLACE_WITH_PUBLIC_SITE_ORIGIN
PUBLIC_SITE_INDEXABLE=false
PUBLIC_ANDROID_AVAILABILITY=
PUBLIC_ANDROID_URL=
PUBLIC_IOS_AVAILABILITY=
PUBLIC_IOS_URL=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_SUPPORT_TELEGRAM_URL=
PUBLIC_SUPPORT_WHATSAPP_URL=
APP_PAYMENT_PROVIDER_NAME=Telebirr
APP_PAYMENT_BUSINESS_ACCOUNT=
APP_PAYMENT_INSTRUCTIONS=
