# Bingo repository secrets and variables. No BillPay credentials or host defaults.
# Database name is fixed to bingo by the workflow and deployment script.
LIGHTSAIL_HOST=REPLACE_WITH_LIGHTSAIL_HOST
LIGHTSAIL_USER=REPLACE_WITH_LIGHTSAIL_USER
LIGHTSAIL_SSH_KEY_B64=REPLACE_WITH_LIGHTSAIL_SSH_KEY_B64
LIGHTSAIL_SSH_KEY=
MYSQL_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
JWT_SECRET=REPLACE_WITH_JWT_SECRET
SPRING_MAIL_USERNAME=REPLACE_WITH_SPRING_MAIL_USERNAME
# Optional until authenticated SMTP email delivery is needed.
SPRING_MAIL_PASSWORD=
BINGO_FLOAT_BANK_ENCRYPTION_KEY=REPLACE_WITH_BINGO_FLOAT_BANK_ENCRYPTION_KEY
# Leave disabled until the one-time production admin bootstrap is approved.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
MYSQL_HOST=REPLACE_WITH_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_USER=bingo_app
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=https://admin.bingo.bakaroo.com
WEBSOCKET_ALLOWED_ORIGINS=https://admin.bingo.bakaroo.com
ADMIN_ACCOUNT_ACTIVATION_URL=https://admin.bingo.bakaroo.com/activate-account
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
VITE_API_BASE_URL=https://api.bingo.bakaroo.com
ADMIN_PUBLIC_URL=https://admin.bingo.bakaroo.com
PUBLIC_SITE_URL=https://bingo.bakaroo.com
PUBLIC_SITE_INDEXABLE=false
PUBLIC_ANDROID_AVAILABILITY=
PUBLIC_ANDROID_URL=
PUBLIC_IOS_AVAILABILITY=
PUBLIC_IOS_URL=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_SUPPORT_TELEGRAM_URL=
PUBLIC_SUPPORT_WHATSAPP_URL=
APP_PAYMENT_PROVIDER_NAME=Telebirr
APP_PAYMENT_BUSINESS_ACCOUNT=
APP_PAYMENT_INSTRUCTIONS=
